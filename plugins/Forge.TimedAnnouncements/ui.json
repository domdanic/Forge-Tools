        { "type": "text", "key": "adWarningMinutes", "label": "Warning lead time (minutes)", "default": "2" },
        { "type": "text", "key": "adWarningText", "label": "Warning message ({minutes} inserts lead time)", "default": "Heads up: ads are scheduled in about {minutes} minutes." }
      ]
