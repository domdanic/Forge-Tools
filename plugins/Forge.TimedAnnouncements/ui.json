      ]
    },
    {
      "title": "Recurring message 2",
      "controls": [
        { "type": "toggle", "key": "message2Enabled", "label": "Enable this message", "default": false },
        { "type": "multiline", "key": "message2Text", "label": "Message", "default": "" },
        { "type": "text", "key": "message2Minutes", "label": "Minimum minutes between sends", "default": "60" },
        { "type": "text", "key": "message2ChatCount", "label": "Minimum chat messages since last send", "default": "10" }
      ]
    },
    {
      "title": "Recurring message 3",
      "controls": [
        { "type": "toggle", "key": "message3Enabled", "label": "Enable this message", "default": false },
        { "type": "multiline", "key": "message3Text", "label": "Message", "default": "" },
        { "type": "text", "key": "message3Minutes", "label": "Minimum minutes between sends", "default": "60" },
