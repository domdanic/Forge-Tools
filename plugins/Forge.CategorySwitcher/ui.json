{
  "sections": [
    {
      "title": "Behavior",
      "controls": [
        { "type": "toggle", "key": "enabled", "label": "Enable automatic category switching", "default": true },
        {
          "type": "select",
          "key": "updateWhen",
          "label": "When category switching is allowed",
          "default": "streaming",
          "options": [
            { "label": "Only while OBS is streaming", "value": "streaming" },
            { "label": "Whenever OBS is connected", "value": "obs-connected" },
            { "label": "Always", "value": "always" }
          ]
        },
        { "type": "text", "key": "debounceSeconds", "label": "Wait before switching (seconds)", "default": "5" },
        { "type": "text", "key": "fallbackCategory", "label": "Optional category for unmapped applications", "default": "" }
      ]
    },
    {
      "title": "Games and applications",
      "controls": [
        {
          "type": "process-category-mappings",
          "key": "mappingEntries",
          "optionsSource": "running-apps.json",
          "label": "Associate a running process with a Twitch category",
          "description": "Search Twitch, save mappings, add optional moderator-friendly chat commands, or switch immediately from a saved card."
        }
      ]
    }
  ]
}
