      { "type": "text", "key": "slotsPayout", "label": "Typical total payout multiplier", "default": "2" }
    ]},
    { "title": "Roulette", "collapsible": true, "initiallyExpanded": false, "description": "European-style 0–36 roulette. Colors and odd/even pay 2× total; a single number pays 36× total.", "controls": [
      { "type": "toggle", "key": "rouletteEnabled", "label": "Enable roulette", "default": true },
