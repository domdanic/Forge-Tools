<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Forge.PluginSdk\Forge.PluginSdk.csproj" />
    <ProjectReference Include="..\Forge.Updater\Forge.Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include=".forge-root" CopyToOutputDirectory="PreserveNewest" />
    <None Include="update-source.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="trusted-publishers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\Forge.SamplePlugin\plugin.json" Link="BundledPlugins\tools.forge.stream-notes\plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\Forge.SamplePlugin\ui.json" Link="BundledPlugins\tools.forge.stream-notes\ui.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.7</Version>
    <UseAppHost>true</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <Target Name="CopyUpdater" AfterTargets="Publish">
    <ItemGroup><UpdaterFiles Include="..\Forge.Updater\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\Forge.Updater*" /></ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
